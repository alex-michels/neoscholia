{#- Страница схолий: данные — src/_data/scholia/odyssey-10.json (стихи Гомера, схолии по частям, аппарат, примечания, журнал).
    Общие детали (шапка, панель чтения, сегмент, журнал, подвал) — в reader/parts.njk, как у текстов из text-body.njk. -#}
{%- import "ui.njk" as ui with context -%}
{%- import "reader/parts.njk" as rd with context -%}
{%- set d = scholia["odyssey-10"] -%}
{%- set jump = [] -%}
{%- for s in d.scholia %}{% set _ = jump.push({ href: "#" ~ s.id, label: s.ref }) %}{% endfor -%}

{% call rd.head("Схолии к «Одиссее». Песнь X", "Остров Эола: стихи 1–4", "", ladder, status, mock, { versions: versions }) %}
        <span>Основа текста: <b>Dindorf, Scholia Graeca in Homeri Odysseam II, Oxford 1855, с. 443–446</b></span>
        <span>Версия <b>{{ version }}</b> · {{ updated }}</span>
        <span>DOI: <b>появится при публикации</b></span>
      {% endcall %}

    {{ rd.toolbar(jump, "Перейти к схолии") }}

    <section class="panel verses" aria-labelledby="homer-h">
      <h2 class="overline" id="homer-h">Гомер, «Одиссея» 10.1–4 — к этим стихам относятся схолии</h2>
      <div class="verses-grid">
        <ol lang="grc">
          {%- for v in d.homer %}
          <li><span>{{ v.grc | safe }}</span></li>
          {%- endfor %}
        </ol>
        <div>
          {%- for lang in ["ru", "en"] %}
          <ol data-lang="{{ lang }}"{% if lang == "en" %} lang="en"{% endif %}>
            {%- for v in d.homer %}
            <li><span>{{ v[lang] | safe }}</span></li>
            {%- endfor %}
          </ol>
          {%- endfor %}
        </div>
      </div>
      <p class="verses-src">Текст Гомера — по изданию A. T. Murray (Loeb, 1919).</p>
    </section>

    <section class="section" aria-labelledby="text">
      {{ ui.sectionHead("Схолии", "Под каждым стихом — все схолии, которые печатает Диндорф, в его порядке. Над каждой частью — сиглы рукописей и строки издания. Перевод леммы (слов Гомера, к которым относится схолия) стоит в начале перевода, перед квадратной скобкой; в квадратных скобках — слова, добавленные переводчиком.", "text") }}
      {%- for s in d.scholia %}

      {% call rd.segment(s.id, { both: s.notes, tagEn: "divergence" }) %}
          {%- call rd.segHead(s.id, 3, s.ref, s.lemma) %}
            {{- rd.chips({ text: "Dindorf " ~ s.dindorf, href: s.scan }, s.chips, s.late) }}
          {%- endcall %}
          <div class="body">
            {%- for p in s.parts %}
            {{ rd.part("grc", p.grc, p.ru, p.en, p.sigla, p.label) }}
            {%- endfor %}
          </div>
          {{- rd.disclosure("Аппарат Диндорфа", s.apparatus) }}
          {{- rd.reviewLog("Журнал рецензии к " ~ s.ref, s.log) }}
      {%- endcall %}
      {%- endfor %}
    </section>

    {%- set licenses %}
        <p>Греческий текст: Scholia Graeca in Homeri Odysseam, ed. W. Dindorf, t. II (Oxford, 1855), по сканам <a href="https://archive.org/details/scholiagraeodyss02homeuoft">Internet Archive</a>; Гомер — Homer, The Odyssey, ed. A. T. Murray (Loeb, 1919). Оба издания — общественное достояние. Чтения издания Понтани обсуждаются в комментарии, его текст не воспроизводится.</p>
        <p>Перевод и комментарий — CC BY-NC-SA 4.0. Журнал рецензии — CC0. Черновики, сверка и арбитраж лежат в <a href="{{ site.repo }}/tree/main/research/texts/odyssey-scholia">репозитории</a>.</p>
    {%- endset %}
    {%- set ai %}
        <p>Первый перевод и новые схолии подготовила модель Claude Opus 5.5 (Anthropic). Независимый перевод с греческого сделала модель другого семейства — GPT-6 Astra (OpenAI, Codex), не видя первого. Сверку текста по сканам и арбитраж выполнили агенты Claude: публикуется один перевод, существенные расхождения вынесены в примечания, остальные разобраны в журнале. Системы ИИ не являются авторами; за текст отвечает редактор, статус его проверки указан вверху страницы.</p>
    {%- endset %}

    {{ rd.textFoot("Схолии к «Одиссее», песнь X, ст. 1–4 / пер. и комм. Александр Михельс. Версия " ~ version ~ ". Neoscholia, 2026. DOI: [появится при публикации].", versions, licenses, ai, " — ") }}
