<header class="site">
    <a class="brand" href="{{ root }}index.html" aria-label="Neoscholia — на главную">
      <b>Neo<span>·</span>scholia</b>
      <small><span lang="grc">νέα σχόλια</span> · {{ site.tagline }}</small>
    </a>
    <nav class="site-nav" aria-label="Разделы сайта">
    {%- for item in site.nav %}
      <a href="{{ root }}{{ item.href }}"{% if item.key == nav %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    </nav>
    <div class="site-tools">
      <button type="button" class="tool theme-toggle" data-theme-toggle aria-label="Переключить светлую и тёмную тему" title="Светлая / тёмная тема">
        <svg class="i-moon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M6.2 1.2a6.9 6.9 0 1 0 8.6 8.6A5.6 5.6 0 0 1 6.2 1.2Z"/></svg>
        <svg class="i-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="currentColor"/><path stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M8 .9v1.7M8 13.4v1.7M.9 8h1.7M13.4 8h1.7M3 3l1.2 1.2M11.8 11.8 13 13M3 13l1.2-1.2M11.8 4.2 13 3"/></svg>
      </button>
    </div>
  </header>
