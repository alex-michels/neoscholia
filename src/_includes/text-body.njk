{#- Страница перевода, собираемая из данных: src/_data/texts/<ключ>.json.
    На странице: front matter с textKey, pageType: "reader" (он же подключает reader.js), ladder, status, version, updated, mock;
    затем {% include "text-body.njk" %}. Общие детали (шапка, панель чтения, сегмент, журнал, подвал) — в reader/parts.njk.
    Поля данных: title, subtitle, crumbs, source, first, intro_ru, intro_en, chapters[], process, versions[], cite, licenses, ai,
    refPrefix (как пишется ссылка на главу: «I.», «§ »), origLang (язык оригинала: la | grc).
    Поля stats и notes[].source нужны скриптам исследования (research/texts/…) и на странице не показываются.
    Необязательные: editor; pagesLabel (подпись страниц, по умолчанию Zacher); logPrefix; bibliography[];
    inlineNotes — значки примечаний уже стоят в c.ru / c.en, а примечания для каждого языка свои (c.notes_ru, c.notes_en);
    у главы: orig (текст оригинала вместо latin), heading (заголовок раздела перед главой). -#}
{%- import "ui.njk" as ui with context -%}
{%- import "reader/parts.njk" as rd with context -%}
{%- set t = texts[textKey] -%}
{%- set au = audio[textKey] if audio and audio[textKey] else {} -%}
{%- set unit = t.logPrefix if t.logPrefix else "главе " -%}
{#- В тексте с разделами заголовок раздела — h3, номер главы — h4; без разделов номер главы — h3. -#}
{%- set level = 4 if (t.chapters | selectattr("heading") | length) else 3 -%}
{%- set jump = [] -%}
{%- for c in t.chapters %}{% set _ = jump.push({ href: "#c" ~ c.chapter, label: t.refPrefix ~ c.chapter, group: c.heading.ru if c.heading else "" }) %}{% endfor -%}

{% call rd.head(t.title, t.subtitle, t.first, ladder, status, mock, { about: t.intro_ru, process: t.process, versions: t.versions }) %}
        <span>Основа текста: <b>{{ rd.grc(t.source) }}</b></span>
        {%- if t.editor %}
        <span>Редактор: <b>{{ t.editor }}</b></span>
        {%- endif %}
        <span>Версия <b>{{ version }}</b> · {{ updated }}</span>
      {% endcall %}

    {{ rd.toolbar(jump) }}
    {%- if t.intro_ru %}

    <section class="panel intro" id="about" aria-labelledby="intro-h" data-fold="Читать введение полностью">
      <h2 class="overline" id="intro-h">О тексте</h2>
      <div class="fold">
        <div class="prose" data-lang="ru">{{ rd.grc(t.intro_ru) }}</div>
        <div class="prose" data-lang="en" lang="en">{{ rd.grc(t.intro_en) }}</div>
      </div>
    </section>
    {%- endif %}

    <section class="section" aria-labelledby="text">
      {{ ui.sectionHead("Текст и перевод", "", "text") }}
      {%- for c in t.chapters %}
      {%- set id = "c" ~ c.chapter %}
      {%- if t.inlineNotes %}
      {%- set notes = { ru: c.notes_ru, en: c.notes_en } %}
      {%- set ru = c.ru %}
      {%- set en = c.en %}
      {%- else %}
      {#- значки примечаний ставятся в конец перевода главы -#}
      {%- set notes = { both: c.notes } %}
      {%- set ru %}{{ c.ru | safe }}{% for n in c.notes %}<sup class="n"><a href="#n{{ n.n }}">{{ n.n }}</a></sup>{% endfor %}{% endset %}
      {%- set en %}{{ c.en | safe }}{% for n in c.notes %}<sup class="n"><a href="#n{{ n.n }}-en">{{ n.n }}</a></sup>{% endfor %}{% endset %}
      {%- endif %}
      {%- if c.heading %}

      <h3 class="sec-head" id="s{{ c.heading.n }}"><span data-lang="ru">{{ c.heading.ru }}</span><span data-lang="en" lang="en">{{ c.heading.en }}</span></h3>
      {%- endif %}

      {% call rd.segment(id, notes) %}
          {%- call rd.segHead(id, level, t.refPrefix ~ c.chapter) %}
            {{- rd.chips({ text: (t.pagesLabel if t.pagesLabel else "Zacher") ~ " " ~ c.pages } if c.pages else none, c.parallels) }}
            {%- for lang in ["ru", "en"] %}
            {%- set a = au[lang][c.chapter] if au[lang] else none %}
            {%- if a and a.hash == (c[lang] | textHash) %}
            <button type="button" class="btn btn--ghost btn--sm listen" data-lang="{{ lang }}"{% if lang == "en" %} lang="en"{% endif %} data-src="{{ page.url | rootPrefix }}audio/{{ textKey }}/{{ a.url.split('/') | last }}" data-fallback="{{ a.url }}" aria-pressed="false" aria-label="{{ 'Слушать перевод главы ' if lang == 'ru' else 'Listen to the translation of chapter ' }}{{ c.chapter }}">{{ 'Слушать' if lang == 'ru' else 'Listen' }} <span class="dur">{{ (a.seconds / 60) | round(0, "ceil") }} {{ 'мин' if lang == 'ru' else 'min' }}</span></button>
            {%- endif %}
            {%- endfor %}
          {%- endcall %}
          <div class="body">
            {{ rd.part(t.origLang, c.orig if c.orig else c.latin, ru, en) }}
          </div>
          {{- rd.reviewLog("Журнал рецензии к " ~ unit ~ c.chapter, c.log) }}
      {%- endcall %}
      {%- endfor %}
    </section>

    {%- if t.process %}

    <section class="section process" id="process" aria-labelledby="proc-h">
      {{ ui.sectionHead("Как сделан перевод", "", "proc-h") }}
      <div class="prose">
        {{ rd.grc(t.process.text) }}
      </div>
      {%- if t.process.stats %}
      {{ ui.stats(t.process.stats) }}
      {%- endif %}
      {%- if t.process.open %}
      <h3>Что осталось проверить</h3>
      <ul>{% for o in t.process.open %}<li>{{ rd.grc(o) }}</li>{% endfor %}</ul>
      {%- endif %}
      {%- if t.bibliography %}
      <h3>Литература к примечаниям</h3>
      <ul class="biblio" data-lang="ru">{% for b in t.bibliography %}<li><b>{{ b.key_ru }}</b> — {{ rd.grc(b.ru) }}</li>{% endfor %}</ul>
      <ul class="biblio" data-lang="en" lang="en">{% for b in t.bibliography %}<li><b>{{ b.key_en }}</b> — {{ rd.grc(b.en) }}</li>{% endfor %}</ul>
      {%- endif %}
    </section>
    {%- endif %}

    {{ rd.textFoot(t.cite | replace("{version}", version), t.versions, t.licenses, t.ai) }}
