 "bas_lines": [
  {
   "ref": "Bas. 23.1",
   "text": "ΤΗΣ ΜΟΥΣΙΚΗΣ"
  },
  {
   "ref": "Bas. 23.2",
   "text": "ΗΚΡΙΒΩΜΕΝΗ ΣΥΝΟΨΙΣ."
  },
  {
   "ref": "Bas. 23.3",
   "text": "Μουσικὴν οἱ παλαιοὶ συνέ-"
  },
  {
   "ref": "Bas. 23.4",
   "text": "χειν εἶπον τὸ πᾶν· οὐδὲν"
  },
  {
   "ref": "Bas. 23.5",
   "text": "γὰρ τῶν ὄντων, συμμετρί-"
  },
  {
   "ref": "Bas. 23.6",
   "text": "ας ἄτερ καὶ ἀναλογίας ἔστιν."
  },
  {
   "ref": "Bas. 23.7",
   "text": "ἀλλ’ οὐδέ τι τῶν γινομένων"
  },
  {
   "ref": "Bas. 23.8",
   "text": "μὴ κατὰ συμμετρίας τῆς προσηκούσης καὶ"
  },
  {
   "ref": "Bas. 23.9",
   "text": "ἀναλογίας γινόμενον, καλῶς ἄν ποτε γένοι-"
  },
  {
   "ref": "Bas. 23.10",
   "text": "το, κἂν τεχνητὸν εἴη, κἂν φυσικὸν, κἂν αἰσθή"
  },
  {
   "ref": "Bas. 23.11",
   "text": "σει ληπτὸν, κἂν περὶ μόνην νόησιν θεωρούμενον."
  },
  {
   "ref": "Bas. 24.1",
   "text": "Η δὲ μουσικὴ, αὐτοσυμμετρία τις ἐστὶ, καὶ"
  },
  {
   "ref": "Bas. 24.2",
   "text": "ἀναλογία, τὸ πᾶν, οἷα τοῦ παντὸς ἁρμονία"
  },
  {
   "ref": "Bas. 24.3",
   "text": "τυγχάνουσα. τάχα δ’ ἄν τις καὶ τὸ θεῖον αὐ-"
  },
  {
   "ref": "Bas. 24.4",
   "text": "τὸ οὐκ ἀπεικότως, ἁρμονίαν ἑαυτοῦ τε καὶ τοῦ"
  },
  {
   "ref": "Bas. 24.5",
   "text": "παντὸς ὀνομάσοι, ἐν ᾧ τὸ πᾶν συναρμολο-"
  },
  {
   "ref": "Bas. 24.6",
   "text": "γούμενον καὶ συμβιβαζόμενον, εὖτε καὶ ὡς"
  },
  {
   "ref": "Bas. 24.7",
   "text": "ἄριστα διαφαίνεται ἔχων. τοσούτου τὴν μου"
  },
  {
   "ref": "Bas. 24.8",
   "text": "σικὴν ἠξίωσαν θαύματος. ἧς ἐν ἅπασιν οὕ-"
  },
  {
   "ref": "Bas. 24.9",
   "text": "τω θεωρουμένης, καὶ πάντα διεπούσης καὶ"
  },
  {
   "ref": "Bas. 24.10",
   "text": "κοσμούσης, καὶ ἡδονὴν μὲν τῇ αἰσθήσει, ἁρ-"
  },
  {
   "ref": "Bas. 24.11",
   "text": "μονίαν δὲ τῇ φύσει, μακαριότητα δὲ τῇ νοή-"
  },
  {
   "ref": "Bas. 24.12",
   "text": "σει χαριζομένης, περὶ τῆς ἐν αἰσθήσει μουσικῆς,"
  },
  {
   "ref": "Bas. 24.13",
   "text": "μᾶλλον δὲ τῆς ἐν μιᾷ τῶν αἰσθήσεων τῇ ἀκοῇ"
  },
  {
   "ref": "Bas. 24.14",
   "text": "θεωρουμένης, ἐν ἐπιτόμῳ διαληψόμεθα."
  },
  {
   "ref": "Bas. 24.15",
   "text": "Φθόγγος ἐστὶ, φωνῆς ἀδιαστάτου ἐναρμό"
  },
  {
   "ref": "Bas. 24.16",
   "text": "νιος τάσις. Διάστημα δὲ φθόγγων, ἡ πρὸς"
  },
  {
   "ref": "Bas. 24.17",
   "text": "ἀλλήλους ποιὰ σχέσις. Σύστημα δὲ, ποιὰ"
  },
  {
   "ref": "Bas. 24.18",
   "text": "διαστημάτων περωχὴ. Αρμονία δὲ, συστη-"
  },
  {
   "ref": "Bas. 24.19",
   "text": "μάτων σύνταξις. Ο μὲν οὖν φθόγγος ἀδιά"
  },
  {
   "ref": "Bas. 24.20",
   "text": "στατός ἐστιν, ὡς ἡ ἐν γεωμετρίᾳ στιγμὴ. ἐναρ-"
  },
  {
   "ref": "Bas. 24.21",
   "text": "μόνιος δὲ λέγεται, διὰ τὸ οὕτως ἐκπεφωνῆ-"
  },
  {
   "ref": "Bas. 24.22",
   "text": "σθαι, ὡς δύνασθαι καὶ μεθ’ ἑτέρου φθόγγου ἐναρμο"
  },
  {
   "ref": "Bas. 24.23",
   "text": "σθῆναι. εἰ δὲ μὴ οὕτως ἐκφωνηθείη, ἀπηχής"
  },
  {
   "ref": "Bas. 24.24",
   "text": "ἐστι φθόγγος, οὐκ ἐναρμόνιος, οὐδ’ ἂν φθόγγος"
  },
  {
   "ref": "Bas. 24.25",
   "text": "ὅλως καλοῖτο, ἀλλὰ ψόφος τις ἄλλως ἐκπε"
  },
  {
   "ref": "Bas. 25.1",
   "text": "φωνημένος, καὶ πρὸς ἁρμονίαν οὐκ εὔχρη-"
  },
  {
   "ref": "Bas. 25.2",
   "text": "στος. Προσηγορίαι δὲ φθόγγων διάφοροι, τῷ"
  }
 ],
