{
 "section": "2",
 "bas_from": "Bas. 25.2 «Προσηγορίαι»",
 "bas_to": "Bas. 27.5 «δίεσιν.»",
 "bas_lines": [
  {
   "ref": "Bas. 25.2",
   "text": "στος. Προσηγορίαι δὲ φθόγγων διάφοροι, τῷ"
  },
  {
   "ref": "Bas. 25.3",
   "text": "ἀπὸ τοῦ βαρέος ἐπὶ τὸ ὀξὺ προόδῳ καὶ τάξει"
  },
  {
   "ref": "Bas. 25.4",
   "text": "τὰς προσηγορίας λαμβάνοντος· Προσλαμ-"
  },
  {
   "ref": "Bas. 25.5",
   "text": "βανόμενος, ὑπάτη ὑπάτων, παρυπάτη"
  },
  {
   "ref": "Bas. 25.6",
   "text": "ὑπάτων, ὑπάτη διάτονος, ὑπάτη μέσων,"
  },
  {
   "ref": "Bas. 25.7",
   "text": "παρυπάτη μέσων, * μέση μόνως, παράμε-"
  },
  {
   "ref": "Bas. 25.8",
   "text": "σος, τρίτη διεζευγμένη, διάτονος διαζευγμέ"
  },
  {
   "ref": "Bas. 25.9",
   "text": "νη, νήτη διεζευγμένη, τρίτη ὑπερβολαίων,"
  },
  {
   "ref": "Bas. 25.10",
   "text": "διάτονος ὑπερβολαίων, νήτη ὑπερβολαίων."
  },
  {
   "ref": "Bas. 25.11",
   "text": "διὰ τούτων ἀπαρτίζεται τὸ ἐν πεντεκαι-"
  },
  {
   "ref": "Bas. 25.12",
   "text": "δεκαχόρδῳ ἑκκαιδεκάχορδον, τοῦ περάτος"
  },
  {
   "ref": "Bas. 25.13",
   "text": "τοῦ ὀκταχόρδου εἰς ἀρχὴν τοῖς μετέπειτα"
  },
  {
   "ref": "Bas. 25.14",
   "text": "λαμβανομένου κατὰ συνέχειαν. ὃν γὰρ λό-"
  },
  {
   "ref": "Bas. 25.15",
   "text": "γον ὁ πρῶτος ἔχων φθόγγος πρὸς τὸν ὄγ-"
  },
  {
   "ref": "Bas. 25.16",
   "text": "δοον ἀναφαίνεται, τὸν αὐτὸν καὶ ὁ ὄγδοος"
  },
  {
   "ref": "Bas. 25.17",
   "text": "πρὸς τὸν πεντεκαιδέκατον ἔχει. καὶ τὰ μὲν"
  },
  {
   "ref": "Bas. 25.18",
   "text": "περὶ φθόγγων ἐν τούτοις."
  },
  {
   "ref": "Bas. 25.19",
   "text": "Τῶν δὲ διαστημάτων, ἐλάχιστον μὲν ἡ δίε"
  },
  {
   "ref": "Bas. 25.20",
   "text": "σις. εἶτα τὸ ἡμιτόνιον, διπλὴν ἔχον ἐπὶ τὸ ὀ-"
  },
  {
   "ref": "Bas. 25.21",
   "text": "ξὺ παραύξησιν τῆς διέσεως. εἶτα ὁ τόνος, δι"
  },
  {
   "ref": "Bas. 25.22",
   "text": "πλοῦν ἔχον τὸ ἡμιτόνιον, τὸν ἐπόγδοον διϊ-"
  },
  {
   "ref": "Bas. 25.23",
   "text": "στάμενος λόγον, ὡς ὁ ἔνατος ἀριθμὸς πρὸς"
  },
  {
   "ref": "Bas. 25.24",
   "text": "τὸν ὄγδοον, ὡς εἶναι τὸ ἡμιτόνιον, οἷον * ὀκτὼ"
  },
  {
   "ref": "Bas. 25.25",
   "text": "ἥμισυ, τὴν δὲ δίεσιν ὅσον † ὀκτωτέταρτον."
  },
  {
   "ref": "Bas. 26.1",
   "text": "εἰ γὰρ καὶ ἡ μονὰς οὐ τέμνεται κατὰ τοὺς ἀριθ-"
  },
  {
   "ref": "Bas. 26.2",
   "text": "μοὺς, ἀλλ’ ἡ ἐν ὕλῃ βλεπομένη μονὰς τέμνε-"
  },
  {
   "ref": "Bas. 26.3",
   "text": "ται γεωμετρικῶς. τὴν γὰρ ἐπόγδοον δια-"
  },
  {
   "ref": "Bas. 26.4",
   "text": "σώζουσαν λόγον νευρὰν, δυνατὸν ὑποτεμεῖν"
  },
  {
   "ref": "Bas. 26.5",
   "text": "εἰς ἡμιεπόγδοον, ὅπερ ἔστιν ἡμιτόνιον, καὶ"
  },
  {
   "ref": "Bas. 26.6",
   "text": "ταύτην πάλιν ὑποτεμεῖν δευτέρως εἰς"
  },
  {
   "ref": "Bas. 26.7",
   "text": "δίεσιν. ἡ γὰρ γεωμετρία καὶ ἐλάττονα ἀπὸ"
  },
  {
   "ref": "Bas. 26.8",
   "text": "τῆς μείζονος κατὰ πάντα τρόπον ἀφαιρεῖ-"
  },
  {
   "ref": "Bas. 26.9",
   "text": "ται εὐθεῖαν, καὶ τῇ ἐλάττονι προστίθησι μεί-"
  },
  {
   "ref": "Bas. 26.10",
   "text": "ζονα. ἔνθεν καὶ ἅπαν σχῆμα, καὶ παραυξῆ-"
  },
  {
   "ref": "Bas. 26.11",
   "text": "σαι κατὰ τὸ δοκοῦν μῆκος, καὶ ἀγαγεῖν εἰς"
  },
  {
   "ref": "Bas. 26.12",
   "text": "μείωσιν δύναται. τῇ δὲ ἀριθμητικῇ τοῦτο ἀ-"
  },
  {
   "ref": "Bas. 26.13",
   "text": "δύνατον. αὐτίκα τὸ δοθὲν τετράγωνον, ἡ"
  },
  {
   "ref": "Bas. 26.14",
   "text": "μὲν ἀριθμητικὴ εἰς ἴσα τεμεῖν τετράγωνα,"
  },
  {
   "ref": "Bas. 26.15",
   "text": "ἢ διπλασιάσαι τὸ δεδομένον οὐ δύναται."
  },
  {
   "ref": "Bas. 26.16",
   "text": "τὸν γὰρ ἑξκαιδέκατον ἀριθμὸν τετράγω-"
  },
  {
   "ref": "Bas. 26.17",
   "text": "νον ὄντα, οὔτε εἰς ἴσα δυνατὸν διαιρεθῆναι"
  },
  {
   "ref": "Bas. 26.18",
   "text": "τετράγωνα (τὰ γὰρ ὀκτὼ τετραγωνισθῆ-"
  },
  {
   "ref": "Bas. 26.19",
   "text": "ναι ἀδύνατον) οὔτε εἰς ἕτερον διπλασια-"
  },
  {
   "ref": "Bas. 26.20",
   "text": "σθῆναι τετράγωνον (τὸν γὰρ τριακοντα-"
  },
  {
   "ref": "Bas. 26.21",
   "text": "δύο ἀριθμὸν τετραγωνισθῆναι ἀμήχανον)"
  },
  {
   "ref": "Bas. 26.22",
   "text": "τῇ γεωμετρίᾳ δὲ τοῦτο ῥᾴδιον. τὴν γὰρ τοῦ"
  },
  {
   "ref": "Bas. 26.23",
   "text": "δοθέντος τετραγώνου πλευρὰν εἰς διάμε-"
  },
  {
   "ref": "Bas. 26.24",
   "text": "τρον ὁ γεωμέτρης μεταλαβὼν, καὶ τετρά"
  },
  {
   "ref": "Bas. 26.25",
   "text": "γωνον αὐτῇ περιθεὶς, ἥμισυ τοῦ δοθέντος τε-"
  },
  {
   "ref": "Bas. 27.1",
   "text": "τραγώνου ποιεῖ. καὶ τὴν διάμετρον πάλιν τοῦ δο"
  },
  {
   "ref": "Bas. 27.2",
   "text": "θέντος μετειληφὼς εἰς πλευρὰν, τὸ δοθὲν δι-"
  },
  {
   "ref": "Bas. 27.3",
   "text": "πλασιάζει τετράγωνον. ταύτη τοι καὶ ὁ ἐπόγ-"
  },
  {
   "ref": "Bas. 27.4",
   "text": "δοος τοῦ τόνου λόγος εἰς ἡμιτόνιον διαιρεῖται, καὶ"
  },
  {
   "ref": "Bas. 27.5",
   "text": "αὖθις εἰς δίεσιν. παραυξήσει δὲ τούτων, καὶ ἕτε"
  }
 ],
