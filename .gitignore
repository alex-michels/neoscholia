# build output and dependencies
site/
node_modules/

# local tool settings
.claude/

# stray downloads from early research sessions in the project root (not part of the project)
/*.html
/*.htm
/*.txt
/*.pdf
/clbody.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# fetched web pages saved during research (not research results)
/research/raw/wave2_items/*.html

# TTS voice samples for comparison (local only)
/tts-samples/

# Python bytecode
__pycache__/

# Audio lives in GitHub releases (scripts/tts/tts.py), never in git
/src/assets/audio/

# page scans of source editions: kept locally (and on the server), never in git; SOURCE.md and SHA256SUMS.txt describe them
research/texts/**/source/**/*.tif
research/texts/**/source/**/*.jpg
research/texts/**/source/**/*.png
research/texts/**/source/**/*.pdf
research/texts/**/source/**/*.jp2
research/texts/**/source/**/*.jpeg
research/texts/**/source/**/*.tiff
research/texts/**/source/**/*.webp

# local review pages for the editor (crops of the scans, which must not be published)
research/texts/**/review/

# downloads made by research agents for studies (page images, OCR, PDFs): local only
research/studies/*/raw/work/
